{
  "agent-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\"$HOME/.agent-memory/bin/memctl\" start --agent antigravity --stdin --agy",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\"$HOME/.agent-memory/bin/memctl\" sync --agent antigravity --stdin --agy",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"$HOME/.agent-memory/bin/memctl\" sync --agent antigravity --stdin --agy",
        "timeout": 30
      }
    ]
  }
}
