.DS_Store

# Local build outputs and dependencies.
/bin/
/dist/
/web/dist/
/web/node_modules/
/coverage/

# Local configuration; keep documented examples trackable.
.env
.env.*
!.env.example

# Local code-search indexes; rebuild with codegraph init / zg index.
/.codegraph/
/.zvec-grep/

# Local agent tool state; not project content.
/.commandcode/

# Local diagram/explainer output; regenerate on demand.
/.archify/
